     "alloc",
     "cost",
     "efficiency",
     "idle",
     "idleLong",
     "key",
     "loadedCost",
     "lost",
     "period",
     "priced",
     "records",
     "sm",
     "smBase",
     "smW",
     "tokensOut",
     "useful",
     "wasted"
