    "efficiency": {
     "type": "number"
    },
    "idle": {
     "type": "number"
    },
    "idleLong": {
     "type": "number"
    },
    "lost": {
     "type": "number"
    },
    "priced": {
     "type": "number"
    },
    "records": {
     "type": "number"
    },
    "sm": {
     "type": "number"
    },
    "smBase": {
     "type": "number"
    },
    "smW": {
     "type": "number"
    },
    "tokensOut": {
     "type": "number"
    },
    "useful": {
     "type": "number"
    },
    "wasted": {
     "type": "number"
    }
