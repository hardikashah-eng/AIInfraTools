{
  "name": "hybrid-tracing",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "One trace view across on-prem and neocloud: shared clock reference, collector tiers, and clock-skew correction for OTLP traces.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "demo": "node tools/fix-skew.mjs --demo",
    "start": "node tools/skew-corrector.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='../**' --test-coverage-lines=97 --test-coverage-branches=70 tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
