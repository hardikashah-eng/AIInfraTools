{
  "name": "fleetscope",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "private": true,
  "description": "Node editor for replaying LLM traffic on a modelled hybrid (on-prem + neocloud) GPU fleet",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude='tests/**' --test-coverage-exclude='../**' --test-coverage-lines=93 --test-coverage-branches=70 tests/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
