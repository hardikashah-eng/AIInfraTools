{
  "name": "aiinfra-tools",
  "version": "0.2.0",
  "description": "Open tools for running GPU fleets: size inference, simulate capacity, find root causes, cap power, deploy on llm-d, and charge back GPU-hours. No dependencies.",
  "license": "Apache-2.0",
  "type": "module",
  "author": "hardikashah-eng",
  "homepage": "https://github.com/hardikashah-eng/AIInfraTools#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hardikashah-eng/AIInfraTools.git"
  },
  "bugs": {
    "url": "https://github.com/hardikashah-eng/AIInfraTools/issues"
  },
  "keywords": [
    "gpu",
    "llm-inference",
    "capacity-planning",
    "finops",
    "kubernetes",
    "vllm",
    "llm-d",
    "root-cause-analysis",
    "chargeback",
    "agent-harness",
    "agent-skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "aiinfra-tools": "bin/aiinfra.mjs",
    "aiinfra": "bin/aiinfra.mjs",
    "fleetops": "fleetops/tools/fleetops.mjs",
    "gpu-health": "gpu-health/tools/gpu-health.mjs",
    "gpu-ledger": "gpu-ledger/tools/ledger.mjs",
    "inference-sizer": "inference-sizer/tools/size.mjs",
    "fleetscope": "fleetscope/tools/fleetscope.mjs",
    "fix-skew": "hybrid-tracing/tools/fix-skew.mjs",
    "aiinfra-mcp": "mcp/server.mjs",
    "harness-ledger": "harness-ledger/tools/harness-ledger.mjs"
  },
  "files": [
    "bin/",
    "mcp/",
    "schemas/",
    "LICENSE",
    "CHANGELOG.md",
    "NOTICE",
    "README.md",
    "fleetops/",
    "gpu-health/",
    "gpu-ledger/",
    "inference-sizer/",
    "fleetscope/",
    "hybrid-tracing/",
    "harness-ledger/",
    "!**/tests/**",
    "!**/node_modules/**",
    "!fleetops/fleet-data/**",
    "!**/*.test.mjs",
    "!**/docs/img/**",
    "!**/*.png",
    "!**/*.gif",
    "fleetops/tests/fixtures/real/philly-job-log-2017-11-07-15.json.gz",
    "fleetops/tests/fixtures/real/philly-machine-list.csv",
    "fleetops/tests/fixtures/real/README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint .",
    "check:formats": "node scripts/check-formats.mjs",
    "test:all": "for t in fleetops gpu-health fleetscope inference-sizer hybrid-tracing gpu-ledger harness-ledger; do (cd $t && npm test) || exit 1; done"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
